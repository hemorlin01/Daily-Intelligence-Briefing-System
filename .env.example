# ===== DIBS Briefing 环境配置 =====
# 复制此文件为 .env 并填入你的值

# ----- AI 摘要 (DeepSeek) -----
# 去 https://platform.deepseek.com 注册，新用户送额度
# LLM_API_KEY=sk-your-deepseek-key
# LLM_API_URL=https://api.deepseek.com/v1/chat/completions
# LLM_MODEL=deepseek-chat

# ----- 邮件推送 (Gmail) -----
# 需要开启 Gmail 的两步验证 + 生成应用专用密码
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_TO=recipient@qq.com

# ----- Telegram 推送 -----
# 去 @BotFather 创建机器人获取 token，去 @userinfobot 获取 chat_id
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234gh
# TELEGRAM_CHAT_ID=123456789

# ----- Bark 推送 (iOS) -----
# App Store 下载 Bark，打开 App 获取设备 key
# BARK_DEVICE_KEY=your-device-key

# ----- 微信推送 (Server酱) -----
# https://sct.ftqq.com/ 扫码关注 → 获取 SendKey
# WECHAT_PUSH_TYPE=serverchan
# WECHAT_PUSH_TOKEN=SCT123456your-send-key

# ----- 企业微信推送 (Webhook机器人) -----
# 企业微信群 → 群设置 → 群机器人 → 添加 → 复制 Webhook 地址
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key
